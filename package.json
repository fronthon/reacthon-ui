{
  "name": "reacthon-ui",
  "private": true,
  "version": "0.0.1",
  "description": "shadcn/ui's components, written in Python, for Reacthon",
  "license": "MIT",
  "author": "Florent Gallaire <fgallaire@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fronthon/reacthon-ui.git"
  },
  "bugs": {
    "url": "https://github.com/fronthon/reacthon-ui/issues"
  },
  "keywords": [
    "python",
    "react",
    "shadcn",
    "reacthon"
  ],
  "type": "module",
  "bin": {
    "reacthon-ui": "bin/reacthon-ui.js"
  },
  "files": [
    "bin",
    "public/r",
    "tools/tsx2py.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "registry": "node tools/registry.js",
    "prepack": "npm run registry",
    "preset": "node tools/preset.js",
    "convert": "for ui in src/presets/*/components/ui/; do node tools/tsx2py.js $ui $ui*.tsx; done",
    "convert:blocks": "for block in src/presets/*/blocks/*/; do node tools/tsx2py.js $block $block*.tsx; done",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "shadcn": "^4.23.0",
    "typescript": "~6.0.2"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@phosphor-icons/react": "^2.1.10",
    "@remixicon/react": "^4.9.0",
    "@shadcn/react": "^0.3.1",
    "@tabler/icons-react": "^3.53.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-table": "^9.3.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "input-otp": "^1.5.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.80.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.2",
    "reacthon": "file:../reacthon",
    "recharts": "^3.8.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8",
    "vaul": "^1.1.2",
    "vite": "^8",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
