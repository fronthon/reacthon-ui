{
  "name": "reacthon-ui",
  "private": true,
  "version": "0.0.1",
  "description": "shadcn/ui's components, written in Python, for Reacthon",
  "license": "MIT",
  "author": "Florent Gallaire <fgallaire@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svelthon/reacthon-ui.git"
  },
  "keywords": [
    "python",
    "react",
    "shadcn",
    "reacthon"
  ],
  "type": "module",
  "bin": {
    "reacthon-ui": "bin/reacthon-ui.js"
  },
  "files": [
    "bin",
    "public/r"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "registry": "shadcn build",
    "prepack": "shadcn build",
    "translate": "node tools/tsx2py.js generated src/components/ui/*.tsx",
    "test:translated": "vitest run --config vitest.generated.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "shadcn": "^4.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.80.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reacthon": "file:../reacthon",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.12"
  }
}
